@startuml
!include estilo.iuml
!pragma layout smetana

left to right direction
actor "Visitante" as V
actor "Usuario registrado" as U
actor "Administrador\nde BD" as A
actor "Analista de calidad\nde datos" as Q
actor "Desarrollador" as Dv
actor "Auditor interno" as Au
actor "GitHub Actions\n<<sistema>>" as GA
actor "GitHub\n(API REST)\n<<sistema>>" as GH
A -up-|> U
Q -up-|> U
Dv -up-|> U
Au -up-|> U
rectangle "Motor de Integridad Multibase NoSQL" {
  usecase "CU01 Registrar cuenta" as CU01
  usecase "CU02 Iniciar sesión" as CU02
  usecase "CU03 Cerrar sesión" as CU03
  usecase "CU04 Gestionar conexiones" as CU04
  usecase "CU05 Gestionar reglas\nde integridad" as CU05
  usecase "CU06 Validar registro\nprevio a la escritura" as CU06
  usecase "CU07 Ejecutar escaneo\npor lotes" as CU07
  usecase "CU08 Registrar violaciones" as CU08
  usecase "CU09 Monitorear motores" as CU09
  usecase "CU10 Consultar dashboard" as CU10
  usecase "CU11 Generar reporte\nde anomalías" as CU11
  usecase "CU12 Exportar reporte PDF" as CU12
  usecase "CU13 Ver usuarios en línea" as CU13
  usecase "CU14 Exportar reporte\na Excel" as CU14
  usecase "CU15 Publicar anomalías\ncomo Issue de GitHub" as CU15
  usecase "CU16 Configurar integración\ncon GitHub" as CU16
  usecase "CU17 Operar el motor\ndesde la CLI" as CU17
  usecase "CU18 Consultar historial\nde escaneos" as CU18
  usecase "CU19 Consultar logs\nde actividad" as CU19
}
V --> CU01
V --> CU02
U --> CU03
U --> CU10
U --> CU13
U --> CU18
U --> CU19
A --> CU04
A --> CU07
A --> CU09
A --> CU16
Q --> CU05
Q --> CU07
Q --> CU11
Q --> CU14
Dv --> CU06
Dv --> CU17
Au --> CU11
GA --> CU17
CU07 ..> CU08 : <<include>>
CU12 ..> CU11 : <<extend>>
CU14 ..> CU11 : <<extend>>
CU15 ..> CU11 : <<extend>>
CU15 ..> CU16 : <<include>>
CU17 ..> CU06 : <<include>>
CU17 ..> CU07 : <<include>>
CU15 --> GH
note bottom of CU03
  La sesión también se cierra
  sola tras 30 min sin actividad.
end note
@enduml

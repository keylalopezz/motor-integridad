# Supabase (control-plane). Usa la service_role key: la app corre en el servidor
# y las tablas tienen RLS activado (la anon key no tiene acceso).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# Clave para cifrar las credenciales de MongoDB/Redis/Cassandra que guardan los usuarios.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡No la cambies despues de guardar conexiones o no podran descifrarse!
ENCRYPTION_KEY=
